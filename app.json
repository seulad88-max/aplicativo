{
  "expo": {
    "name": "FluxoPrime App",
    "slug": "fluxoprime-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "fluxoprime-app",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#24152F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fluxoprime.app"
    },
    "android": {
      "package": "com.fluxoprime.app"
    },
    "windows": {
      "icon": "./assets/images/icon.png"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
