{
  "expo": {
    "name": "FluxoPrime App",
    "slug": "fluxoprime-app",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "fluxoprime-app",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fluxoprime.app"
    },
    "android": {
      "package": "com.fluxoprime.app"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ae3715be-9843-4329-9598-be97d68673ad"
      }
    }
  }
}
